NODE_ENV=development
PORT=4000
# Neon connection string (Dashboard → Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Comma-separated allowed frontend origins (add your Vercel URL in production)
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Shared secret between the Next.js server and this API (openssl rand -hex 32). Same value in frontend .env.local
BACKEND_API_KEY=
# AES-256-GCM key for OAuth tokens: 64 hex chars (openssl rand -hex 32). Losing it = reconnect Gmail.
TOKEN_ENCRYPTION_KEY=
# The only Google account allowed to connect Gmail
ALLOWED_EMAIL=you@gmail.com

# Anthropic API key (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# OpenAI API key (platform.openai.com → API keys)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Free key: aistudio.google.com → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest
# Which provider "Auto" tries first: gemini | openai | anthropic (others with a key are fallbacks)
AI_PROVIDER=gemini
# Cloudinary (Dashboard → API environment variable): cloudinary://KEY:SECRET@CLOUD_NAME
CLOUDINARY_URL=
# Google Cloud OAuth "Web application" client
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/oauth/google/callback
